{
  "name": "remote-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Personal, self-hosted, browser-based remote terminal for one owner. Native Linux or Ubuntu on WSL2, Cloudflare ingress, Node-native Argon2id.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.7.0"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm run setup --workspace @remote-terminal/server",
    "start": "npm run start --workspace @remote-terminal/server",
    "dev": "npm run dev --workspace @remote-terminal/server",
    "build": "npm run build --workspace @remote-terminal/client",
    "test": "npm run test --workspace @remote-terminal/server",
    "test:unit": "npm run test:unit --workspace @remote-terminal/server",
    "test:integration": "npm run test:integration --workspace @remote-terminal/server",
    "test:e2e": "npm run test:e2e --workspace @remote-terminal/server"
  }
}
