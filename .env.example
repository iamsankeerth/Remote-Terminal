# Copy to .env if you ever need local overrides. Never commit .env.
# The application reads secrets from environment variables only.
#
# Cloudflare Access provisioning is manual (see docs/setup.md). These values are collected by
# `npm run setup` and stored in the XDG config file, not here.
#
# CLOUDFLARE_TEAM_DOMAIN=myteam
# CLOUDFLARE_AUD=your-application-audience
# CLOUDFLARE_OWNER_EMAIL=you@example.com
# CLOUDFLARE_HOSTNAME=terminal.example.com
#
# LOG_LEVEL=info
